<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TermTunes</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Keeps its own SharpConsoleUI version. publish.sh rewrites it on every
         release, and this project is copied out of the repository, where the
         central list does not exist. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

<ItemGroup Condition="Exists('../../../../SharpConsoleUI/SharpConsoleUI.csproj')">
    <ProjectReference Include="../../../../SharpConsoleUI/SharpConsoleUI.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../../SharpConsoleUI/SharpConsoleUI.csproj')">
    <PackageReference Include="SharpConsoleUI" Version="2.10.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/covers/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
