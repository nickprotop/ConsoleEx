<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NativeAOT smoke test: this app publishes with PublishAot and runs headlessly.
         Trim/AOT warnings are treated as errors so any regression in the library's
         AOT-compatibility fails the publish. See
         docs/superpowers/specs/2026-06-11-nativeaot-support-design.md -->
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2070;IL2072;IL2075;IL3050;IL3051;IL3056</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SharpConsoleUI\SharpConsoleUI.csproj" />
  </ItemGroup>

  <!-- No trim-warning suppression here any more. AngleSharp.Css used to call
       Activator.CreateInstance on a runtime Type in its four CssCalc*Expression
       Compute methods, which trim analysis reported as IL2072 and which had to be
       collapsed through ILC's singlewarnassembly option, since the warnings were
       attributed to AngleSharp's own methods rather than to any call site here.

       1.2.2 does not produce them. Verified by publishing this fixture for
       NativeAOT with the suppression removed: no IL2072, no IL2104, and the
       binary still renders HTML with CSS calc(). SharpConsoleUI's own code has
       always had full IL2072-as-error analysis and still does. -->

</Project>
